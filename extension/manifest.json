{
  "manifest_version": 3,
  "name": "Jira Custom Tempo",
  "version": "0.2.0",
  "description": "Twój zalogowany czas pracy w Jira Cloud: wpisy na zgłoszenie, sumy i pasek normy dziennej.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.atlassian.net/*"],
      "exclude_matches": ["https://*.atlassian.net/wiki/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
